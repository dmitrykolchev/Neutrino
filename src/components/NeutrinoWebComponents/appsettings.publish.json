{
    "Kestrel": {
        "Endpoints": {
            "MyHttpEndpoint": {
                "Url": "http://localhost:8080"
            }
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File",
            "Serilog.Enrichers.ClientInfo"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "System": "Warning",
                "Microsoft": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning",
                "Orleans": "Warning",
                "Sam.DocumentGenerator": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [IP: {ClientIp}] (Td={ThreadId}, User={UserName}) {SourceContext:l}, {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "D:\\Publish\\NeutrinoWebComponents\\logs\\webapp-.log",
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [IP: {ClientIp}] (Td={ThreadId}, User={UserName}) {SourceContext:l}, {Message:lj}{NewLine}{Exception}",
                    "fileSizeLimitBytes": 10000000,
                    "rollingInterval": "Day",
                    "rollOnFileSizeLimit": true,
                    "retainedFileCountLimit": 10,
                    "shared": true
                }
            }
        ],
        "Enrich": [ "FromLogContext", "WithThreadId" ]
    },
    "AllowedHosts": "*"
}
